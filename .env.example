# WebSentinel-CS :: Environment Configuration
# Copy to .env or configure in system environment

# Network binding (Do NOT use 0.0.0.0 without authentication / TLS proxy)
HOST=127.0.0.1
PORT=4000

# SQLite Database path
DB_PATH=./data/sentinel.sqlite

# Operation Mode
NODE_ENV=production
DEMO_MODE=false
TRUST_PROXIES=false

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:4000,http://localhost:4000

# Endpoint Scanner Target Allowlist (comma-separated IP/CIDR/Host)
# Leave empty by default. Add specific internal/external subnets only when authorized:
# e.g. SCAN_ALLOWLIST=api.empresa.com,192.168.1.0/24
SCAN_ALLOWLIST=

# Telemetry retention in days
RETENTION_DAYS=90
STORE_PASSED_EVENTS=false
BACKUP_KEEP=7

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
