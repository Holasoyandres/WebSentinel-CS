# WebSentinel-CS :: Environment Configuration
# Copy to .env or configure in system environment

# Network binding (Do NOT use 0.0.0.0 without authentication / TLS proxy)
HOST=127.0.0.1
PORT=4000

# SQLite Database path
DB_PATH=./data/sentinel.sqlite

# Operation Mode
NODE_ENV=production
DEMO_MODE=false

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:4000,http://localhost:4000

# Endpoint Scanner Target Allowlist (comma-separated IP/CIDR/Host)
SCAN_ALLOWLIST=127.0.0.1,localhost,172.16.0.0/16

# Telemetry retention in days
RETENTION_DAYS=90

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
