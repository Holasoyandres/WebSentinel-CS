{
  "name": "websentinel/laravel-sentinel",
  "description": "Enterprise Web Security Middleware & Out-of-Band Threat Telemetry for Laravel 10/11/12",
  "keywords": ["laravel", "security", "waf", "sqli", "xss", "bruteforce", "cybersecurity", "soc", "honeypot"],
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Holasoyandres",
      "homepage": "https://github.com/Holasoyandres"
    }
  ],
  "require": {
    "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "illuminate/http": "^10.0 || ^11.0 || ^12.0",
    "illuminate/auth": "^10.0 || ^11.0 || ^12.0",
    "illuminate/events": "^10.0 || ^11.0 || ^12.0",
    "symfony/http-foundation": "^6.0 || ^7.0"
  },
  "autoload": {
    "psr-4": {
      "WebSentinel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WebSentinel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "WebSentinel\\WebSentinelServiceProvider"
      ]
    }
  }
}
